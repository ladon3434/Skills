# Unreal Engine project. Text is normalised; binaries go to Git LFS (git lfs install once per machine).
* text=auto
# Shell scripts and node modules stay LF (CRLF breaks bash hooks on a clean checkout); cmd files stay CRLF.
*.sh text eol=lf
*.mjs text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Unreal packages.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
# Localization data is read byte for byte: the compiled .locres is binary, manifests and archives are UTF-16.
# A text rule rewrites their bytes and the editor then fails loading the .locres.
*.locres binary
*.manifest binary
*.archive binary

# Raw content sources.
*.fbx filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.3ds filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text

# Third-party binaries a plugin ships (no build makes them).
*.dll filter=lfs diff=lfs merge=lfs -text
*.lib filter=lfs diff=lfs merge=lfs -text
*.pdb filter=lfs diff=lfs merge=lfs -text
*.exe filter=lfs diff=lfs merge=lfs -text
*.a filter=lfs diff=lfs merge=lfs -text

# Binary formats a text rule would silently destroy, kept out of LFS (small, must survive a clone without LFS).
*.pdf -text
*.ico -text
*.ttf -text
*.otf -text
*.woff -text
*.woff2 -text
*.zip -text
*.7z -text
*.gz -text
