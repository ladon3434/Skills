#!/bin/sh
# A candidate must run: the Microsoft Store alias is a python on PATH that only prints an advert.
PY=""
for c in "$PYTHON" python python3; do
	[ -n "$c" ] && "$c" -c "import sys" >/dev/null 2>&1 && { PY="$c"; break; }
done
[ -n "$PY" ] || { py -3 -c "import sys" >/dev/null 2>&1 && exec py -3 -B "$(dirname "$0")/../skills/ue-content-gates/scripts/py/find_asset_refs.py" "$@"; }
[ -n "$PY" ] || { echo "find-asset-refs: no Python 3 found - put python on PATH or set PYTHON" >&2; exit 2; }
exec "$PY" -B "$(dirname "$0")/../skills/ue-content-gates/scripts/py/find_asset_refs.py" "$@"
